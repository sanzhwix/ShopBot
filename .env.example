# Copy to .env (make env does it) and fill in BOT_TOKEN.

# Telegram bot token from @BotFather. Empty = run without the bot (browser only).
BOT_TOKEN=

# Public HTTPS address of the Mini App. Leave empty: the cloudflared tunnel sets it.
PUBLIC_URL=

# Code for "/owner CODE" in the bot: lets a Telegram account manage a demo shop.
OWNER_CODE=demo2026

# Password of the founder metrics page (/admin).
ADMIN_PASSWORD=admin2026

# demo = ShopBot's Kaspi demo page (default); link = the shop's own Kaspi payment link.
PAYMENT_MODE=demo

# true = the Mini App also works in a normal browser with a shared demo user
# (handy for the projector). Set to false for real testers.
DEV_AUTH=true
